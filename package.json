        "lint": "eslint . --quiet",
        "pree2e": "node scripts/prepare-e2e.mjs",
        "e2e": "playwright test",
        "check:release": "node scripts/release-check.mjs",
        "typecheck": "tsc --noEmit --pretty false",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
