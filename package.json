    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env.local scripts/run-vite-standalone.mjs",
        "dev:next": "node --env-file-if-exists=.env.local scripts/run-app.mjs dev",
        "dev:api": "node --env-file-if-exists=.env.local --import tsx/esm scripts/standalone-server.ts",
