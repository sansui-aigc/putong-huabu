# ============================================================
# 普通画布（Putong Canvas）环境变量模板
# 复制为 .env.local 后按需填写：
#   Copy-Item .env.example .env.local
# ============================================================

# ---- 基础 ----
# 站点对外 URL（影响回调与绝对链接）
# NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ---- 本地文件存储（默认，无需数据库）----
# 数据目录，不设置则使用默认本地目录
# VOZEB_PRO_DATA_DIR=./data

# ---- 模型渠道（生成必需）----
# 渠道定义在 config/models.json，密钥通过环境变量注入。
# 每个渠道的 apiKeyEnv 对应下面的变量名（以 config/models.example.json 为例）：
VOZEB_PRO_PROVIDER_API_KEY=sk-你的中转站APIKey

# ---- 安装向导（可选）----
# 使用网页安装向导 /install 初始化时的令牌
# VOZEB_PRO_INSTALL_TOKEN=your-install-token

# ---- 代理（可选，需要走代理访问模型时）----
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ---- 端口（可选，默认 3002）----
# PORT=3002
